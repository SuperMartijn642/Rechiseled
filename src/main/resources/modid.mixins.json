{
  "required": true,
  "minVersion": "${mixin_minimum_version}",
  "package": "${mod_package}.${mixin_package}",
  "compatibilityLevel": "${mixin_compatibility_level}",
  "mixins": [
    "MinecraftServerMixin",
    "PlayerListMixin"
  ],
  "client": [
    "CreateWorldScreenMixin",
    "MinecraftMixin",
    "MultiPlayerGameModeMixin",
    "WorldOpenFlowsMixin"
  ],
  "server": [
    "ServerMainMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  }
}
